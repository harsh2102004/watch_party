# -----------------------------------------------------------------------------
# Watch Party Client Configuration (.env.example)
# -----------------------------------------------------------------------------

# Backend API and Socket.IO server base URL.
# In local development, defaults to http://localhost:4000.
# On Vercel, set this to your Render server URL (e.g. https://watchparty-server.onrender.com).
# In production builds, omitting this variable will trigger an explicit configuration error screen.
VITE_SERVER_URL=http://localhost:4000
