# -----------------------------------------------------------------------------
# Watch Party Server Configuration (.env.example)
# -----------------------------------------------------------------------------

# Port number on which the Express and Socket.IO server will listen.
# Render automatically injects PORT=10000 in production.
PORT=4000

# Runtime environment (development | production | test).
# In production, missing JWT_SECRET will abort startup.
NODE_ENV=development

# Comma-separated list of allowed client origins for CORS and Socket.IO.
# Include local Vite dev server and production Vercel domain. Trailing slashes are stripped.
CLIENT_URL=http://localhost:5173,https://your-app-name.vercel.app

# When true, dynamically permits CORS from any branch preview URL ending in .vercel.app.
ALLOW_VERCEL_PREVIEWS=true

# Secret cryptographic key used to sign and verify JWT authentication tokens (7-day expiry).
# Required in production. Run `openssl rand -hex 32` to generate a strong key.
JWT_SECRET=your-random-32-byte-hex-jwt-secret-key-here

# Controls whether unauthenticated visitors can join rooms as guests.
# Set to 'false' if user registration/login is mandatory.
ALLOW_GUESTS=true

# MongoDB connection string for persisting rooms (7-day TTL) and chat messages.
# If omitted or offline, the server automatically degrades to memory-only mode.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.3z8ggla.mongodb.net/watchparty?retryWrites=true&w=majority

# Optional legacy SQLite persistence toggle (true | false).
PERSIST_ROOMS=false
